<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Streamy</AssemblyName>
    <RootNamespace>Streamy</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- Drawn by UI/AppIcon.cs; regenerate with the render-icon developer switch (see the README). -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Description>Mirror and control Android phones from Windows over USB or Wi-Fi</Description>
    <!-- Controls are built in code, never in the WinForms designer. -->
    <NoWarn>$(NoWarn);WFO1000</NoWarn>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Bindings for FFmpeg 9.0.1, the version of the avcodec-63 DLLs scrcpy 5.0.1 ships. -->
    <PackageReference Include="FFmpeg.AutoGen" Version="9.0.1.1" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />
    <PackageReference Include="NAudio.Wasapi" Version="3.3.0" />
    <PackageReference Include="QRCoder" Version="1.8.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Streamy.Core\Streamy.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\app.ico" LogicalName="app.ico" />
  </ItemGroup>

  <!--
    adb, scrcpy-server and the FFmpeg DLLs from tools/fetch-deps.ps1 are embedded and unpacked to
    %LOCALAPPDATA%\Streamy\bin\<scrcpy version> on first run, so the release stays one exe.
  -->
  <ItemGroup>
    <EmbeddedResource Include="ThirdParty\*" Exclude="ThirdParty\.version" LogicalName="deps/%(Filename)%(Extension)" />
  </ItemGroup>

  <Target Name="CheckThirdParty" BeforeTargets="BeforeBuild" Condition="!Exists('ThirdParty\scrcpy-server')">
    <Warning Text="src/Streamy/ThirdParty is empty: run 'pwsh tools/fetch-deps.ps1' so adb and scrcpy-server are embedded." />
  </Target>

</Project>
